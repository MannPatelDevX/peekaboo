{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peekaboo",
  "version": "0.1.0",
  "identifier": "ai.devxlabs.peekaboo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "beforeBuildCommand": "npm run sidecar:release && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Peekaboo",
        "width": 220,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/peekaboo-hook"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
